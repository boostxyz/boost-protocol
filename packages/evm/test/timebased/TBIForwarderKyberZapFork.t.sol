pragma solidity ^0.8.24;

import {Test, Vm} from "lib/forge-std/src/Test.sol";

import {ERC20} from "@solady/tokens/ERC20.sol";

import {TBIForwarder} from "contracts/timebased/TBIForwarder.sol";
import {
    TBIForwarderAdapters,
    IUniswapV4PositionManager,
    PoolKey,
    Currency
} from "contracts/timebased/TBIForwarderAdapters.sol";

/// @notice Arbitrum fork test executing a real Kyber ZaaS build against the live WBTC/cbBTC
/// FairFlow campaign pool, end to end through the deployed TBIForwarder proxy (upgraded in-fork to
/// this tree's implementation).
///
/// The zap calldata below is a genuine ZaaS `in/route/build` response captured at FORK_BLOCK with
/// `sender` = the deployed forwarder and `recipient` = USER, so the test is deterministic: it must
/// always run at FORK_BLOCK, where the captured route's pool state and deadline remain valid. To
/// refresh the fixture, re-run route + build (see BOOST-6642) and update the constants together.
contract TBIForwarderKyberZapForkTest is Test {
    /// @dev Block the ZaaS route was built against; the fixture is only valid at this block.
    uint256 internal constant FORK_BLOCK = 489377366;

    /// @dev Deployed TBIForwarder proxy on Arbitrum (deploys/42161.json).
    address internal constant FORWARDER = 0x7A33Bcf7588190e3123235db746339045207Bb93;

    /// @dev Kyber zap router from the ZaaS build response (`routerAddress` == `tokenTarget` ==
    /// `allowanceHubAddress`, so the forwarder approves and calls a single target).
    address internal constant ZAP_ROUTER = 0x455C51505E90819aBdC691B98Aee6a11ED41d618;

    /// @dev Canonical Uniswap V4 PositionManager on Arbitrum.
    address internal constant POSITION_MANAGER = 0xd88F38F930b7952f2DB2432Cb002E7abbF3dD869;

    /// @dev Native Arbitrum USDC — the any-token input side of the zap.
    address internal constant USDC = 0xaf88d065e77c8cC2239327C5EDb3A432268e5831;

    address internal constant WBTC = 0x2f2a2543B76A4166549F7aaB2e75Bef0aefC5B0f;
    address internal constant CBBTC = 0xcbB7C0000aB88B473b1f5aFd9ef808440eed33Bf;

    /// @dev Live WBTC/cbBTC FairFlow campaign pool (canonical V4 PoolId).
    bytes32 internal constant POOL_ID = 0x4fd69d55704d8c40ebbd6d0086f1c827eed02bfb4a42cea8aafda66b45dab22e;

    /// @dev The zap recipient the calldata was built for.
    address internal constant USER = 0x1111111111111111111111111111111111111111;

    uint256 internal constant AMOUNT_IN = 100e6; // 100 USDC

    /// @dev ZaaS route predictions at FORK_BLOCK, used as tolerance anchors for the emitted event.
    uint256 internal constant PREDICTED_LIQUIDITY = 25780609;
    uint256 internal constant PREDICTED_AMOUNT0 = 87161; // WBTC sats
    uint256 internal constant PREDICTED_AMOUNT1 = 67287; // cbBTC sats

    /// @dev keccak256("UniswapV4LPDeposit(address,address,bytes32,uint128,uint256,uint256)")
    bytes32 internal constant DEPOSIT_TOPIC =
        keccak256("UniswapV4LPDeposit(address,address,bytes32,uint128,uint256,uint256)");

    /// @dev Captured ZaaS `in/route/build` calldata (sender = FORWARDER, recipient = USER).
    bytes internal constant ZAP_CALLDATA =
        hex"";

    function test_Fork_KyberZapV4_EndToEnd() public {
        // Requires an archive-capable Arbitrum RPC (public nodes only serve recent state). Skipped
        // when unset so the suite passes without one — CI provisions only VITE_SEPOLIA_RPC_URL.
        string memory rpcUrl = vm.envOr("VITE_ARBITRUM_RPC_URL", string(""));
        vm.skip(bytes(rpcUrl).length == 0);
        vm.createSelectFork(rpcUrl, FORK_BLOCK);

        // Upgrade the deployed proxy to this tree's implementation and whitelist the zap router.
        TBIForwarder forwarder = TBIForwarder(payable(FORWARDER));
        TBIForwarder implementation = new TBIForwarder();
        vm.startPrank(forwarder.owner());
        forwarder.upgradeToAndCall(address(implementation), "");
        forwarder.setSwapRouterAllowed(ZAP_ROUTER, true);
        vm.stopPrank();

        deal(USDC, USER, AMOUNT_IN);
        vm.prank(USER);
        ERC20(USDC).approve(FORWARDER, AMOUNT_IN);

        IUniswapV4PositionManager positionManager = IUniswapV4PositionManager(POSITION_MANAGER);
        uint256 expectedTokenId = positionManager.nextTokenId();

        vm.recordLogs();
        vm.prank(USER);
        forwarder.depositKyberZapV4(positionManager, ZAP_ROUTER, USDC, AMOUNT_IN, ZAP_CALLDATA, POOL_ID, USER);

        // The NFT was minted to USER on the canonical PositionManager, in the campaign pool.
        assertEq(positionManager.nextTokenId(), expectedTokenId + 1, "exactly one position minted");
        assertEq(positionManager.ownerOf(expectedTokenId), USER, "minted to receiver");
        (PoolKey memory poolKey,) = positionManager.getPoolAndPositionInfo(expectedTokenId);
        assertEq(keccak256(abi.encode(poolKey)), POOL_ID, "position is in the campaign pool");
        assertEq(Currency.unwrap(poolKey.currency0), WBTC, "currency0");
        assertEq(Currency.unwrap(poolKey.currency1), CBBTC, "currency1");

        uint128 liquidity = positionManager.getPositionLiquidity(expectedTokenId);

        // The emitted event reports the real position: liquidity exactly, amounts within 2% of the
        // ZaaS route prediction for this block (they differ from it only by execution rounding).
        (uint128 eventLiquidity, uint256 amount0, uint256 amount1) = _findDepositEvent();
        assertEq(eventLiquidity, liquidity, "event liquidity == canonical position liquidity");
        assertApproxEqRel(uint256(liquidity), PREDICTED_LIQUIDITY, 0.02e18, "liquidity vs quote");
        assertApproxEqRel(amount0, PREDICTED_AMOUNT0, 0.02e18, "amount0 vs quote");
        assertApproxEqRel(amount1, PREDICTED_AMOUNT1, 0.02e18, "amount1 vs quote");

        // The stateless forwarder retains nothing; ZaaS refunds leftovers to the recipient itself.
        assertEq(ERC20(USDC).balanceOf(FORWARDER), 0, "no USDC left in forwarder");
        assertEq(ERC20(WBTC).balanceOf(FORWARDER), 0, "no WBTC left in forwarder");
        assertEq(ERC20(CBBTC).balanceOf(FORWARDER), 0, "no cbBTC left in forwarder");
        assertEq(ERC20(USDC).balanceOf(USER), 0, "input fully consumed");
        assertEq(ERC20(USDC).allowance(FORWARDER, ZAP_ROUTER), 0, "router approval reset");
    }

    /// @dev Extracts the single UniswapV4LPDeposit log emitted by the forwarder.
    function _findDepositEvent() internal returns (uint128 liquidity, uint256 amount0, uint256 amount1) {
        Vm.Log[] memory logs = vm.getRecordedLogs();
        for (uint256 i = 0; i < logs.length; i++) {
            if (logs[i].emitter != FORWARDER || logs[i].topics[0] != DEPOSIT_TOPIC) continue;
            assertEq(address(uint160(uint256(logs[i].topics[1]))), USER, "event user");
            assertEq(address(uint160(uint256(logs[i].topics[2]))), POSITION_MANAGER, "event positionManager");
            assertEq(logs[i].topics[3], POOL_ID, "event poolId");
            uint256 rawLiquidity;
            (rawLiquidity, amount0, amount1) = abi.decode(logs[i].data, (uint256, uint256, uint256));
            return (uint128(rawLiquidity), amount0, amount1);
        }
        revert("UniswapV4LPDeposit not emitted");
    }
}
