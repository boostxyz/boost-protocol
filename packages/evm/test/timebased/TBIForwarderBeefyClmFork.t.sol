pragma solidity ^0.8.24;

import {Test, Vm} from "lib/forge-std/src/Test.sol";

import {ERC20} from "@solady/tokens/ERC20.sol";

import {TBIForwarder} from "contracts/timebased/TBIForwarder.sol";
import {BeefyClmParams, BeefySwapLeg} from "contracts/timebased/TBIForwarderAdapters.sol";

/// @notice Surface of the live Beefy CLM the fork test reads to size and verify the deposit.
interface IBeefyVaultConcLiqView {
    function wants() external view returns (address, address);
    function isCalm() external view returns (bool);
    function previewDeposit(uint256 amount0, uint256 amount1)
        external
        view
        returns (uint256 shares, uint256 amount0Used, uint256 amount1Used, uint256 fee0, uint256 fee1);
}

/// @notice Robinhood Chain fork test zapping into the live Beefy GLD/USDG CLM reward pool through
/// the deployed TBIForwarder proxy (upgraded in-fork to this tree's implementation), with real
/// KyberSwap aggregator calldata: (a) USDG in, one leg USDG→GLD; (b) native ETH in, two legs
/// ETH→USDG + ETH→GLD.
///
/// The swap calldata below is genuine Kyber `route/build` output captured at FORK_BLOCK with
/// `sender` = `recipient` = the deployed forwarder, so the test is deterministic: it must always
/// run at FORK_BLOCK, where the captured routes' pool state and deadlines remain valid. To refresh
/// the fixtures, re-run route + build for all three legs and update the constants together.
contract TBIForwarderBeefyClmForkTest is Test {
    /// @dev Block the Kyber routes were built against; the fixtures are only valid at this block.
    uint256 internal constant FORK_BLOCK = 58011292;

    /// @dev Deployed TBIForwarder proxy on Robinhood Chain (canonical CREATE2 address).
    address internal constant FORWARDER = 0x7A33Bcf7588190e3123235db746339045207Bb93;

    /// @dev KyberSwap MetaAggregationRouterV2 on Robinhood Chain (`routerAddress` in every build).
    address internal constant KYBER_ROUTER = 0x6131B5fae19EA4f9D964eAc0408E4408b66337b5;

    /// @dev Beefy `uniswap-cow-robinhood-usdg-gld`: the CLM (cowToken) and its reward pool (rCow).
    address internal constant CLM = 0x2e35f0951cFfaF89eb9ADdE94C60475E3745Cc15;
    address internal constant REWARD_POOL = 0x03B023542F20b0FF3b36C6091a3960Daf1a29A3f;

    /// @dev The CLM's `wants()`: token0 = USDG (6 dec), token1 = GLD (18 dec).
    address internal constant USDG = 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168;
    address internal constant GLD = 0xC9a981FEE1F9DEc688bb123ccDeCc63D0deBFC4e;

    address internal constant USER = 0x1111111111111111111111111111111111111111;

    /// @dev Case (a): 1000 USDG in, 600 of it swapped into GLD, the remaining 400 deposited as is.
    uint256 internal constant USDG_AMOUNT_IN = 1000e6;
    uint256 internal constant USDG_SWAP_IN = 600e6;
    uint256 internal constant PREDICTED_GLD_OUT_A = 1495774463086475007;

    /// @dev Case (b): 0.1 ETH in, 0.05 swapped into each pool side.
    uint256 internal constant ETH_LEG_IN = 0.05 ether;
    uint256 internal constant ETH_AMOUNT_IN = 0.1 ether;
    uint256 internal constant PREDICTED_USDG_OUT_B = 124350086;
    uint256 internal constant PREDICTED_GLD_OUT_B = 309879078500333055;

    /// @dev keccak256("Deposit(address,address,address,uint256)")
    bytes32 internal constant DEPOSIT_TOPIC = keccak256("Deposit(address,address,address,uint256)");

    /// @dev Captured Kyber `route/build` calldata, USDG → GLD, 600 USDG.
    bytes internal constant SWAP_USDG_TO_GLD =
        hex"";

    /// @dev Captured Kyber `route/build` calldata, native ETH → USDG, 0.05 ETH.
    bytes internal constant SWAP_ETH_TO_USDG =
        hex"";

    /// @dev Captured Kyber `route/build` calldata, native ETH → GLD, 0.05 ETH.
    bytes internal constant SWAP_ETH_TO_GLD =
        hex"";

    TBIForwarder internal forwarder;

    /// @dev Forks RH at FORK_BLOCK, upgrades the deployed proxy to this tree's implementation and
    /// whitelists the Kyber router — the two owner actions BOOST-6740 batches through the timelock.
    /// Returns false when no RPC is configured so the caller can skip.
    function _forkAndUpgrade() internal returns (bool) {
        // Requires an archive-capable Robinhood Chain RPC. Skipped when unset so the suite passes
        // without one — CI provisions only VITE_SEPOLIA_RPC_URL.
        string memory rpcUrl = vm.envOr("ROBINHOOD_MAINNET_RPC_URL", string(""));
        if (bytes(rpcUrl).length == 0) return false;
        vm.createSelectFork(rpcUrl, FORK_BLOCK);

        forwarder = TBIForwarder(payable(FORWARDER));
        TBIForwarder implementation = new TBIForwarder();
        vm.startPrank(forwarder.owner());
        forwarder.upgradeToAndCall(address(implementation), "");
        forwarder.setSwapRouterAllowed(KYBER_ROUTER, true);
        vm.stopPrank();

        (address token0, address token1) = IBeefyVaultConcLiqView(CLM).wants();
        assertEq(token0, USDG, "wants token0");
        assertEq(token1, GLD, "wants token1");
        assertTrue(IBeefyVaultConcLiqView(CLM).isCalm(), "pool must be calm at FORK_BLOCK");
        return true;
    }

    function test_Fork_BeefyClm_UsdgInput_OneLeg() public {
        vm.skip(!_forkAndUpgrade());

        deal(USDG, USER, USDG_AMOUNT_IN);
        vm.prank(USER);
        ERC20(USDG).approve(FORWARDER, USDG_AMOUNT_IN);

        // Shares the CLM would mint for the un-swapped USDG plus the quoted GLD, as a tolerance anchor.
        (uint256 predictedShares,,,,) =
            IBeefyVaultConcLiqView(CLM).previewDeposit(USDG_AMOUNT_IN - USDG_SWAP_IN, PREDICTED_GLD_OUT_A);

        BeefyClmParams memory p = BeefyClmParams({
            clm: CLM,
            rewardPool: REWARD_POOL,
            inputToken: USDG,
            amountIn: USDG_AMOUNT_IN,
            swapRouter: KYBER_ROUTER,
            swap0: BeefySwapLeg({amountIn: 0, swapCalldata: ""}),
            swap1: BeefySwapLeg({amountIn: USDG_SWAP_IN, swapCalldata: SWAP_USDG_TO_GLD}),
            minShares: predictedShares - predictedShares / 33,
            receiver: USER
        });

        uint256 stakedBefore = ERC20(CLM).balanceOf(REWARD_POOL);

        vm.recordLogs();
        vm.prank(USER);
        uint256 gasBefore = gasleft();
        forwarder.depositBeefyCLM(p);
        uint256 gasUsed = gasBefore - gasleft();
        emit log_named_uint("gas: depositBeefyCLM USDG one-leg", gasUsed);

        uint256 rCow = ERC20(REWARD_POOL).balanceOf(USER);
        emit log_named_uint("rCow received (USDG one-leg)", rCow);
        assertGt(rCow, 0, "rCow minted to receiver");
        assertApproxEqRel(rCow, predictedShares, 0.03e18, "rCow vs previewDeposit at the quoted swap output");
        assertEq(ERC20(CLM).balanceOf(REWARD_POOL) - stakedBefore, rCow, "cow staked 1:1 for the rCow");
        _assertDepositEvent(USDG, USDG_AMOUNT_IN);
        _assertForwarderClean();
        assertEq(ERC20(USDG).balanceOf(USER), 0, "input fully pulled");
        emit log_named_uint("USDG refunded to user (unconsumed remainder)", ERC20(USDG).balanceOf(USER));
        emit log_named_uint("GLD refunded to user (unconsumed remainder)", ERC20(GLD).balanceOf(USER));
    }

    function test_Fork_BeefyClm_NativeInput_TwoLegs() public {
        vm.skip(!_forkAndUpgrade());

        vm.deal(USER, ETH_AMOUNT_IN);

        (uint256 predictedShares,,,,) =
            IBeefyVaultConcLiqView(CLM).previewDeposit(PREDICTED_USDG_OUT_B, PREDICTED_GLD_OUT_B);

        BeefyClmParams memory p = BeefyClmParams({
            clm: CLM,
            rewardPool: REWARD_POOL,
            inputToken: address(0),
            amountIn: ETH_AMOUNT_IN,
            swapRouter: KYBER_ROUTER,
            swap0: BeefySwapLeg({amountIn: ETH_LEG_IN, swapCalldata: SWAP_ETH_TO_USDG}),
            swap1: BeefySwapLeg({amountIn: ETH_LEG_IN, swapCalldata: SWAP_ETH_TO_GLD}),
            minShares: predictedShares - predictedShares / 33,
            receiver: USER
        });

        uint256 stakedBefore = ERC20(CLM).balanceOf(REWARD_POOL);

        vm.recordLogs();
        vm.prank(USER);
        uint256 gasBefore = gasleft();
        forwarder.depositBeefyCLM{value: ETH_AMOUNT_IN}(p);
        uint256 gasUsed = gasBefore - gasleft();
        emit log_named_uint("gas: depositBeefyCLM ETH two-leg", gasUsed);

        uint256 rCow = ERC20(REWARD_POOL).balanceOf(USER);
        emit log_named_uint("rCow received (ETH two-leg)", rCow);
        assertGt(rCow, 0, "rCow minted to receiver");
        assertApproxEqRel(rCow, predictedShares, 0.03e18, "rCow vs previewDeposit at the quoted swap outputs");
        assertEq(ERC20(CLM).balanceOf(REWARD_POOL) - stakedBefore, rCow, "cow staked 1:1 for the rCow");
        assertEq(USER.balance, 0, "all ETH consumed by the two legs");
        _assertDepositEvent(address(0), ETH_AMOUNT_IN);
        _assertForwarderClean();
        emit log_named_uint("USDG refunded to user (unconsumed remainder)", ERC20(USDG).balanceOf(USER));
        emit log_named_uint("GLD refunded to user (unconsumed remainder)", ERC20(GLD).balanceOf(USER));
    }

    /// @dev The stateless forwarder retains nothing of the call and approves nothing afterward.
    function _assertForwarderClean() internal view {
        assertEq(ERC20(USDG).balanceOf(FORWARDER), 0, "no USDG left in forwarder");
        assertEq(ERC20(GLD).balanceOf(FORWARDER), 0, "no GLD left in forwarder");
        assertEq(ERC20(CLM).balanceOf(FORWARDER), 0, "no cow left in forwarder");
        assertEq(ERC20(REWARD_POOL).balanceOf(FORWARDER), 0, "no rCow left in forwarder");
        assertEq(FORWARDER.balance, 0, "no ETH left in forwarder");
        assertEq(ERC20(USDG).allowance(FORWARDER, KYBER_ROUTER), 0, "router approval reset");
        assertEq(ERC20(USDG).allowance(FORWARDER, CLM), 0, "clm USDG approval reset");
        assertEq(ERC20(GLD).allowance(FORWARDER, CLM), 0, "clm GLD approval reset");
        assertEq(ERC20(CLM).allowance(FORWARDER, REWARD_POOL), 0, "reward pool approval reset");
    }

    /// @dev Asserts the single `Deposit` log the forwarder emitted: user, the reward pool as target,
    /// the input asset, and the full amountIn — the exact shape the forwarder-indexer matches on.
    function _assertDepositEvent(address asset, uint256 amount) internal {
        Vm.Log[] memory logs = vm.getRecordedLogs();
        bool found;
        for (uint256 i = 0; i < logs.length; i++) {
            if (logs[i].emitter != FORWARDER || logs[i].topics[0] != DEPOSIT_TOPIC) continue;
            assertFalse(found, "exactly one Deposit");
            found = true;
            assertEq(address(uint160(uint256(logs[i].topics[1]))), USER, "event user");
            assertEq(address(uint160(uint256(logs[i].topics[2]))), REWARD_POOL, "event target");
            assertEq(address(uint160(uint256(logs[i].topics[3]))), asset, "event asset");
            assertEq(abi.decode(logs[i].data, (uint256)), amount, "event amount");
        }
        assertTrue(found, "Deposit not emitted");
    }
}
